# Modelo das variaveis de ambiente. Copie para .env e preencha.
# O .env nao vai para o repositorio: ele esta no .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://seuprojeto.supabase.co
SUPABASE_ANON_KEY=
# Ignora as politicas de seguranca em nivel de linha. Nunca exponha no frontend
# nem em repositorio publico.
SUPABASE_SERVICE_ROLE_KEY=

# ── Infraestrutura ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
SCAN_TMP_DIR=/tmp/scans
MAX_REPO_SIZE_MB=100
SCAN_TIMEOUT_SECONDS=300

# ── Aplicacao ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Origens autorizadas no CORS. Lista separada por virgula.
ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=troque-por-um-valor-aleatorio

# ── Limites de requisicao (opcional; os padroes estao em app/core/config.py) ──
# RATE_LIMIT_CRIAR_ANALISE_MIN=5
# RATE_LIMIT_CRIAR_ANALISE_HORA=30
# RATE_LIMIT_LEITURA_MIN=120
# RATE_LIMIT_REMOCAO_MIN=20
# RATE_LIMIT_CONTA_HORA=3
