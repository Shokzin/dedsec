{
  "name": "dedsec",
  "displayName": "DedSec",
  "description": "Mostra vulnerabilidades de seguranca direto no editor, antes do commit. Traz o scanner embutido; precisa apenas de Python 3.11+ instalado.",
  "version": "0.2.0",
  "publisher": "DedSec",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dedsec.scanFile",
        "title": "DedSec: Analisar arquivo atual"
      },
      {
        "command": "dedsec.scanWorkspace",
        "title": "DedSec: Analisar projeto inteiro"
      }
    ],
    "configuration": {
      "title": "DedSec",
      "properties": {
        "dedsec.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Comando do Python 3.11+ (ex.: python, py). Vazio = detectar automaticamente."
        },
        "dedsec.scannerDir": {
          "type": "string",
          "default": "",
          "description": "Pasta que contém o pacote 'scanner'. Vazio = usar o do projeto aberto e, na falta dele, o scanner embutido na extensão."
        },
        "dedsec.runOn": {
          "type": "string",
          "enum": [
            "type",
            "save"
          ],
          "default": "type",
          "description": "Quando analisar: enquanto digita ('type') ou só ao salvar ('save')."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.js",
    "package": "node build.js && npx --yes @vscode/vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shokzin/dedsec.git"
  },
  "bugs": {
    "url": "https://github.com/Shokzin/dedsec/issues"
  },
  "homepage": "https://dedsec-beta.vercel.app",
  "icon": "icon.png",
  "keywords": [
    "security",
    "seguranca",
    "vulnerabilities",
    "sast",
    "static analysis",
    "owasp",
    "cwe",
    "pre-commit"
  ],
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  }
}
