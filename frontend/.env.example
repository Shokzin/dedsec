# Variaveis do frontend. Copie para frontend/.env e preencha.
# Tudo que comeca com VITE_ vai para o pacote servido ao navegador:
# nunca coloque aqui a chave service_role nem qualquer outro segredo.

VITE_SUPABASE_URL=https://seuprojeto.supabase.co
VITE_SUPABASE_ANON_KEY=
# Em producao, o endereco publico da API (ex.: https://dedsec-api.onrender.com)
VITE_API_URL=http://localhost:8000
